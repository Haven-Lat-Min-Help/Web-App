# Same Supabase project as the other Haven apps. Publishable key — safe to
# ship in the browser bundle, RLS is what actually protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend Express server (see ../Backend) — for endpoints that go through
# service-role RPCs instead of direct-to-Supabase (e.g. POST /organizations).
VITE_BACKEND_URL=http://localhost:3000
